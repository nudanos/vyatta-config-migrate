use strict;
use warnings;
use lib "/opt/vyatta/share/perl5/";
use File::Copy qw(move);
use XorpConfigParser;

my $orig_cfg = shift;
exit 1 if ( !defined($orig_cfg) );

my $xcp = XorpConfigParser->new();
$xcp->parse($orig_cfg);

# the name of a node; comments have none
sub name_of {
    my ($node) = @_;
    return $node->{'name'} // q{};
}

# the children of the node at @path
sub children_at {
    my @path = @_;
    my $node = $xcp->get_node( \@path );
    return defined($node) ? @{ $node->{'children'} // [] } : ();
}

# subnet options that dhcp-server 2 does not have
my @unsupported = qw(
  bootfile-name failover ip-forwarding ntp-server pop-server smtp-server
  static-route tftp-server-name time-offset time-server wpad-url
);

sub is_unsupported {
    my ($name) = @_;
    foreach my $option (@unsupported) {
        return 1 if ( index( $name, $option ) == 0 );
    }
    return 0;
}

# comment out unsupported commands
foreach my $hashSNN ( children_at( 'service', 'dhcp-server' ) ) {
    if ( name_of($hashSNN) =~ /^dynamic-DNS-update/x ) {
        $xcp->comment_out_node($hashSNN);
    }
    foreach my $hashSubnet ( @{ $hashSNN->{'children'} // [] } ) {
        foreach my $child ( @{ $hashSubnet->{'children'} // [] } ) {
            $xcp->comment_out_node($child) if is_unsupported( name_of($child) );
        }
    }
}

my $tmpfile = "/tmp/vyatta_migrate_dhcp_server.$$";
$xcp->write_file($tmpfile)  or exit 1;
move( $tmpfile, $orig_cfg ) or exit 1;

exit 0;
