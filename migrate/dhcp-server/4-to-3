# migration of dhcp-server when downgrading from islavista to hollywood
# the following migration is to move the node 'authoritative' from
# 'service dhcp-server shared-network-name <>' to 'service dhcp-server
# shared-network-name <> subnet <>'.

# We check if a shared-network has 'authoritative enable'
# If yes, all subnets under that shared-network,
# have 'authoritative' with a value 'enable' else
# all subnets under that shared-network have 'authoritative disable'.

use strict;
use warnings;
use lib "/opt/vyatta/share/perl5/";
use File::Copy qw(move);
use XorpConfigParser;

my $orig_cfg = shift;
exit 1 if ( !defined($orig_cfg) );

my $xcp = XorpConfigParser->new();
$xcp->parse($orig_cfg);

# the name of a node; comments have none
sub name_of {
    my ($node) = @_;
    return $node->{'name'} // q{};
}

# the children of the node at @path
sub children_at {
    my @path = @_;
    my $node = $xcp->get_node( \@path );
    return defined($node) ? @{ $node->{'children'} // [] } : ();
}

# comment out authoritative under all shared-networks
# get authoritative enable or disable per shared-network
my %SNN_authoritative;
foreach my $hashSNN ( children_at( 'service', 'dhcp-server' ) ) {
    next unless ( name_of($hashSNN) =~ /^shared-network-name/x );
    foreach my $child ( @{ $hashSNN->{'children'} // [] } ) {
        next unless ( name_of($child) =~ /^authoritative/x );
        $SNN_authoritative{ $hashSNN->{'name'} } =
          ( name_of($child) =~ /authoritative[ ]enable/x ) ? 1 : 0;
        $xcp->comment_out_node($child);
    }
}

# if 'authoritative enable' under shared-network
# for all subnets under that shared-network
# create node 'authoritative' with value 'enable'
# else create node 'authoritative' with value 'disable'
foreach my $hashSNN ( children_at( 'service', 'dhcp-server' ) ) {
    next unless ( name_of($hashSNN) =~ /^shared-network-name/x );
    my $all_subnets_authoritative = $SNN_authoritative{ $hashSNN->{'name'} } // 0;
    foreach my $hashSubnet ( @{ $hashSNN->{'children'} // [] } ) {
        next unless ( name_of($hashSubnet) =~ /^subnet/x );
        $xcp->set_value(
            [
                'service', 'dhcp-server', $hashSNN->{'name'}, $hashSubnet->{'name'},
                'authoritative'
            ],
            $all_subnets_authoritative == 1 ? 'enable' : 'disable'
        );
    }
}

my $tmpfile = "/tmp/vyatta_migrate_dhcp_server.$$";
$xcp->write_file($tmpfile)  or exit 1;
move( $tmpfile, $orig_cfg ) or exit 1;

exit 0;
