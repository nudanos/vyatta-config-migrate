interfaces {
    restore false
    ethernet eth0 {
        disable false
        address 192.168.1.1 {
            prefix-length 24
            broadcast 192.168.1.255
        }
        hw-id 00:0c:29:aa:bb:cc
    }
    ethernet eth1 {
        address 10.1.0.1 {
            prefix-length 16
        }
    }
}
service {
    dhcp {
        relay {
            interface eth1 {
                server 10.9.9.9
                relay-options {
                    port 67
                }
            }
        }
    }
    dhcp-relay {
        interface eth0
        server 10.8.8.8
        relay-options {
            max-size 576
        }
    }
    dhcp-server {
        name LAN {
            interface eth0
            network-mask 24
            start 192.168.1.100 {
                stop 192.168.1.199
            }
            default-router 192.168.1.1
            dns-server 192.168.1.1
            lease 86400
            authoritative "enable"
        }
        name OTHER {
            interface eth1
            network-mask 16
            start 10.1.5.1 {
                stop 10.1.5.99
            }
        }
        shared-network-name OLD {
            192.168.1.0/24 {
                start 192.168.1.10 {
                    stop 192.168.1.20
                }
                domain-name "example.com"
            }
        }
    }
    http {
        port 8080
    }

